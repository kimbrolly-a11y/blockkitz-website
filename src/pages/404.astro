---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockDecoration from '../components/BlockDecoration.astro';

const title = 'Page not found — Block Kitz';
const description = 'The page you were looking for seems to have wandered off. Let us help you find your way back.';
---

<BaseLayout title={title} description={description}>
  <section class="bb-stars relative overflow-hidden pt-16 pb-20 md:pt-24 md:pb-28">
    <BlockDecoration />
    <div class="relative z-10 mx-auto max-w-2xl px-5 text-center md:px-8">
      <p class="font-display text-[8rem] font-extrabold leading-none text-bb-primary drop-shadow-[0_8px_24px_rgba(255,152,0,0.4)] md:text-[10rem]">
        404
      </p>
      <h1 class="mt-2 text-3xl font-extrabold text-white md:text-4xl">
        That block slipped off the board.
      </h1>
      <p class="mt-4 text-bb-text-dim">
        The page you were looking for doesn't exist here — maybe the link is old, or maybe it got lost along the way.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
        <a href="/" class="bb-btn">
          <span aria-hidden="true">🏠</span>
          <span>Back to home</span>
        </a>
        <a href="/support" class="bb-btn bb-btn--ghost">Contact support</a>
      </div>
    </div>
  </section>
</BaseLayout>
