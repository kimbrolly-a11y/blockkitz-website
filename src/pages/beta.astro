---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockDecoration from '../components/BlockDecoration.astro';

import shot1 from '../assets/screenshots/1-modes.png';
import shot2 from '../assets/screenshots/2-levels.png';
import shot3 from '../assets/screenshots/3-achievements.png';
import shot4 from '../assets/screenshots/4-adventure.png';
import shot5 from '../assets/screenshots/5-daily.png';

const title = 'Join the Beta — Block Kitz';
const description =
  'Help launch Block Kitz on Google Play. Solo indie dev needs 12 testers to keep the app installed for 14 days before Google publishes it. 3-step opt-in, no commitment beyond an occasional play.';

const GROUP_URL = 'https://groups.google.com/g/block-kitz-beta--testers';
const TEST_URL = 'https://play.google.com/apps/testing/com.blockkitz.game';

const shots = [
  { src: shot1, alt: 'Three game modes in Block Kitz' },
  { src: shot2, alt: '30 themed chapters across 3 modes' },
  { src: shot3, alt: '22 hidden achievements' },
  { src: shot4, alt: 'Adventure mode — gems, bombs, frozen cells' },
  { src: shot5, alt: 'Daily login, tasks & challenges' },
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="bb-stars relative overflow-hidden pt-10 pb-10 md:pt-16 md:pb-14">
    <BlockDecoration />
    <div class="relative z-10 mx-auto max-w-3xl px-5 text-center md:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-bb-primary">Closed Testing</p>
      <h1 class="mt-4 text-4xl font-extrabold text-white md:text-5xl">
        Help me launch <span class="text-bb-pink">Block Kitz</span>.
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-bb-text-dim">
        I'm a solo indie dev. Google needs <strong class="text-white">12 testers</strong> to keep the app installed for <strong class="text-white">14 days</strong> before they'll let me publish. The more the merrier 💛
      </p>
      <p class="mx-auto mt-4 max-w-xl text-bb-text-dim">
        All you do: <strong class="text-white">install it and play once in a while for 2 weeks.</strong> That's it.
      </p>
    </div>
  </section>

  <!-- What is Block Kitz (mini) -->
  <section class="relative mx-auto mt-2 max-w-4xl px-5 md:px-8">
    <div class="rounded-[28px] bg-white/5 p-6 ring-1 ring-white/10 md:backdrop-blur-sm md:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-bb-text-faded">What you'll be testing</p>
      <h2 class="mt-2 font-display text-2xl font-extrabold text-white md:text-3xl">
        Block Kitz v1.0.1
      </h2>
      <ul class="mt-4 grid gap-3 text-sm text-bb-text-dim sm:grid-cols-2">
        <li>✨ <strong class="text-white">15,000+ levels</strong> across 30 themed chapters</li>
        <li>🎮 <strong class="text-white">3 game modes</strong> — Classic, Pivot Blocks, Adventure</li>
        <li>🛡️ <strong class="text-white">Kid-safe</strong> — non-personalized ads, no profiles, no tracking</li>
        <li>📴 <strong class="text-white">Plays offline</strong> — only optional rewarded ads need a connection</li>
        <li>💰 <strong class="text-white">Free</strong> — no in-app purchases in this build</li>
        <li>👩‍💻 Made by <strong class="text-white">one indie developer</strong> (me!)</li>
      </ul>
    </div>
  </section>

  <!-- The 3 Steps -->
  <section class="relative mx-auto mt-12 max-w-3xl px-5 md:px-8">
    <h2 class="text-center text-3xl font-extrabold text-white md:text-4xl">
      How to <span class="text-bb-primary">opt in</span>
    </h2>
    <p class="mt-3 text-center text-sm text-bb-text-faded">
      Whole flow takes about 3 minutes of clicks + a 1-hour wait while Google syncs.
    </p>

    <ol class="mt-10 space-y-6">
      <!-- Step 1 -->
      <li class="rounded-[28px] bg-white/5 p-6 ring-1 ring-white/10 md:p-8">
        <div class="flex items-start gap-4">
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-bb-primary to-bb-primary-dark font-display text-xl font-extrabold text-bb-bg-deep shadow-lg">1</span>
          <div class="flex-1">
            <h3 class="text-xl font-extrabold text-white">Join the testers Google Group</h3>
            <p class="mt-2 text-sm text-bb-text-dim">
              Joining the group automatically adds you to the tester list on Play Console. Takes about 1 minute. Choose <strong class="text-white">"Each email"</strong> or <strong class="text-white">"Digest"</strong> when prompted — either is fine.
            </p>
            <a
              href={GROUP_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="bb-btn mt-4 w-full justify-center sm:w-auto"
            >
              <span aria-hidden="true">📋</span>
              <span>Join the Google Group</span>
              <span aria-hidden="true" class="ml-1">→</span>
            </a>
          </div>
        </div>
      </li>

      <!-- Step 2 -->
      <li class="rounded-[28px] bg-white/5 p-6 ring-1 ring-white/10 md:p-8">
        <div class="flex items-start gap-4">
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-bb-info to-bb-grape font-display text-xl font-extrabold text-white shadow-lg">2</span>
          <div class="flex-1">
            <h3 class="text-xl font-extrabold text-white">Wait ~1 hour, then opt in on Android</h3>
            <p class="mt-2 text-sm text-bb-text-dim">
              Google takes about an hour to sync the tester list. After that, tap the link below <strong class="text-white">on your Android phone</strong> and tap <strong class="text-white">"Become a tester"</strong>. The Play Store install button appears within a few minutes.
            </p>
            <a
              href={TEST_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="bb-btn mt-4 w-full justify-center sm:w-auto"
            >
              <span aria-hidden="true">📲</span>
              <span>Open Tester Opt-in</span>
              <span aria-hidden="true" class="ml-1">→</span>
            </a>
          </div>
        </div>
      </li>

      <!-- Step 3 -->
      <li class="rounded-[28px] bg-white/5 p-6 ring-1 ring-white/10 md:p-8">
        <div class="flex items-start gap-4">
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-bb-pink to-bb-grape font-display text-xl font-extrabold text-white shadow-lg">3</span>
          <div class="flex-1">
            <h3 class="text-xl font-extrabold text-white">
              <span class="font-normal text-bb-text-faded">(Optional but huge help)</span><br />
              Send quick feedback as you play
            </h3>
            <p class="mt-2 text-sm text-bb-text-dim">
              A 2-minute form. Honest feedback — bugs, confusion, what you loved — makes the next build better.
            </p>
            <a href="/feedback" class="bb-btn bb-btn--ghost mt-4 w-full justify-center sm:w-auto">
              <span aria-hidden="true">💬</span>
              <span>Open the feedback form</span>
              <span aria-hidden="true" class="ml-1">→</span>
            </a>
          </div>
        </div>
      </li>
    </ol>
  </section>

  <!-- Important warning -->
  <section class="relative mx-auto mt-10 max-w-2xl px-5 md:px-8">
    <div class="rounded-2xl bg-bb-danger/10 p-5 ring-1 ring-bb-danger/30">
      <p class="text-sm text-bb-text-dim">
        <strong class="text-bb-danger">⚠️ Important:</strong> Use the <strong class="text-white">same Gmail account</strong> your Android phone is signed into, otherwise the tester opt-in won't link up.
      </p>
    </div>
  </section>

  <!-- Screenshots -->
  <section class="relative mx-auto mt-16 max-w-6xl px-5 md:px-8">
    <h2 class="text-center text-2xl font-extrabold text-white md:text-3xl">
      A quick look at what you'll get
    </h2>
    <div class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-6 md:grid md:grid-cols-5 md:gap-5 md:overflow-visible">
      {
        shots.map((s) => (
          <div class="group relative shrink-0 snap-center md:shrink">
            <div class="overflow-hidden rounded-[28px] bg-white/5 p-2 ring-1 ring-white/10 transition group-hover:-translate-y-1 group-hover:ring-white/30">
              <Image
                src={s.src}
                alt={s.alt}
                widths={[220, 440]}
                sizes="(min-width: 768px) 18vw, 60vw"
                class="h-auto w-[60vw] rounded-[22px] md:w-full"
              />
            </div>
          </div>
        ))
      }
    </div>
    <p class="mt-2 text-center text-xs text-bb-text-faded md:hidden">Swipe to see more →</p>
  </section>

  <!-- For parents -->
  <section class="relative mx-auto mt-16 max-w-3xl px-5 text-center md:px-8">
    <p class="text-bb-text-dim">
      Testing this with your kids? Read how Block Kitz keeps children safe on our
      <a href="/safety" class="font-semibold text-bb-primary hover:underline">Children's Safety page</a> —
      COPPA, GDPR-K, and Google Play Families Policy aligned.
    </p>
  </section>

  <!-- Closing thank you -->
  <section class="relative mx-auto mt-16 max-w-2xl px-5 text-center md:px-8">
    <div class="rounded-[32px] bg-gradient-to-br from-bb-grape/20 via-bb-info/15 to-bb-pink/20 p-8 ring-1 ring-white/10 md:p-12">
      <p class="font-display text-2xl font-extrabold text-white md:text-3xl">
        Thank you 💛
      </p>
      <p class="mt-3 text-bb-text-dim">
        Every install is one of the 12 that gets me to launch. I read every piece of feedback myself.
      </p>
      <p class="mt-4 font-semibold text-bb-pink">
        — Kimberly
      </p>
      <p class="mt-6 text-xs text-bb-text-faded">
        Questions? Email <a href="mailto:support@blockkitz.com" class="font-semibold text-bb-primary hover:underline">support@blockkitz.com</a>
      </p>
    </div>
  </section>
</BaseLayout>
