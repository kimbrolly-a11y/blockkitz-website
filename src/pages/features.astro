---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import BlockDecoration from '../components/BlockDecoration.astro';

const title = 'Features — Block Kitz';
const description =
  'Three game modes, 1,000+ levels, daily rewards, a spin wheel, beautiful music, and a family-safe foundation. See what makes Block Kitz different.';

const modes = [
  {
    tag: 'Classic',
    accent: '#ffd700',
    title: 'Drag & drop, pure bliss',
    body:
      '8×8 grid. A 3-piece tray. Fill full rows or columns to clear them. Ten themed chapters — from sunny meadows to soul-lit nebulae — with gems to gather along the way.',
    bullets: ['10 themed chapters', 'Gem collection', 'Combo multipliers', 'Hand-crafted puzzles'],
  },
  {
    tag: 'Pivot',
    accent: '#2aa7ff',
    title: 'Modern Tetris-style',
    body:
      'Rotate, move, and drop tetrominoes on a 10-wide well. Full SRS rotation, T-Spin bonuses, hold piece, and guideline scoring. 100 levels of escalating challenge.',
    bullets: ['SRS rotation', 'T-Spin detection', 'Hold piece', 'Guideline scoring'],
  },
  {
    tag: 'Adventure',
    accent: '#9b4bff',
    title: 'Objective-based quests',
    body:
      'Collect stars ⭐ and pentas 🔶. Defuse bomb gems. Melt frozen cells. Unlock locked gems. 1,000+ levels across 10 visual chapters — from "Hidden Glade" to "Soul\u2019s Nexus."',
    bullets: ['1,000+ levels', 'Gem objectives', 'Bombs & ice', '10 chapters'],
  },
];

const extras = [
  { icon: '📅', title: 'Daily rewards', description: 'A 7-day login streak calendar with escalating prizes — come back each day and the rewards get better.', accent: 'primary' as const },
  { icon: '🎯', title: 'Daily challenge', description: 'A fresh curated puzzle every single day, with modifiers like Precision, Speed, Gem Rush, and Ice Fury.', accent: 'danger' as const },
  { icon: '🎡', title: 'Spin wheel', description: 'Earn free spins during play. Win coins and power-ups — never real money, never random-chance purchases.', accent: 'pink' as const },
  { icon: '💣', title: 'Power-ups', description: 'Bomb, row-blast, column-blast, undo, and streak shield. Use them when the board gets tough.', accent: 'info' as const },
  { icon: '🏆', title: 'Achievements', description: 'Over 20 lifetime achievements plus session-based mastery badges. Something new to chase every session.', accent: 'success' as const },
  { icon: '🐹', title: 'Hamster mascot', description: 'An adorable hamster cheers you on as you play. Makes a good play feel great — and a bad one still cute.', accent: 'grape' as const },
  { icon: '🎹', title: 'Beautiful music', description: '4 ambient piano moods — Peaceful Garden, Rainy Evening, Ocean Calm, Starlit Night. Perfect for quiet time.', accent: 'info' as const },
  { icon: '📴', title: '100% offline', description: 'No internet required. Play on a plane, in the car, anywhere. No login, no account, no sign-up.', accent: 'success' as const },
];

const differentiators = [
  { label: 'Forced ads',       bk: 'None',  typical: 'Every 2–3 games' },
  { label: 'Data collection',  bk: 'Zero',  typical: 'Extensive' },
  { label: 'COPPA compliance', bk: 'Full',  typical: 'Often unclear' },
  { label: 'Game modes',       bk: '3 distinct', typical: 'Usually 1' },
  { label: 'Level count',      bk: '1,000+ per mode', typical: 'Often endless / no structure' },
  { label: 'Offline play',     bk: 'Fully', typical: 'Many require internet' },
];
---

<BaseLayout title={title} description={description}>
  <!-- Intro -->
  <section class="bb-stars relative overflow-hidden pt-10 pb-12 md:pt-16 md:pb-16">
    <BlockDecoration />
    <div class="relative z-10 mx-auto max-w-4xl px-5 text-center md:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-bb-primary">Features</p>
      <h1 class="mt-4 text-4xl font-extrabold text-white md:text-5xl">
        Three modes. <span class="text-bb-pink">One</span> cozy world.
      </h1>
      <p class="mt-4 text-lg text-bb-text-dim">
        Every feature in Block Kitz was designed around three ideas: be kind to kids, be generous with content, and be a joy to play.
      </p>
    </div>
  </section>

  <!-- Modes -->
  <section class="relative mx-auto max-w-6xl px-5 md:px-8">
    <div class="space-y-6 md:space-y-8">
      {
        modes.map((mode, i) => (
          <article
            class:list={[
              'grid gap-6 rounded-[32px] bg-white/5 p-6 ring-1 ring-white/10 backdrop-blur-sm md:grid-cols-[140px_1fr] md:p-10',
              i % 2 === 1 && 'md:bg-white/[0.07]',
            ]}
          >
            <div class="flex items-start justify-center md:justify-start">
              <span
                class="inline-flex items-center justify-center rounded-2xl px-5 py-2 font-display text-sm font-extrabold uppercase tracking-[0.15em] text-bb-bg-deep shadow-lg"
                style={`background: linear-gradient(180deg, ${mode.accent} 0%, color-mix(in srgb, ${mode.accent} 70%, #000) 100%);`}
              >
                {mode.tag}
              </span>
            </div>
            <div>
              <h2 class="text-2xl font-extrabold text-white md:text-3xl">{mode.title}</h2>
              <p class="mt-3 text-bb-text-dim">{mode.body}</p>
              <ul class="mt-5 grid grid-cols-2 gap-2 md:grid-cols-4">
                {mode.bullets.map((b) => (
                  <li class="rounded-full bg-white/5 px-3 py-1.5 text-center text-xs font-semibold text-bb-text-dim ring-1 ring-white/10">
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- What's inside -->
  <section class="relative mx-auto mt-20 max-w-6xl px-5 md:px-8">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold text-white md:text-4xl">What's <span class="text-bb-primary">inside</span>?</h2>
      <p class="mt-3 text-bb-text-dim">Content, rewards, and personality for every kind of play session.</p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {extras.map((e) => <FeatureCard {...e} />)}
    </div>
  </section>

  <!-- Differentiator table -->
  <section class="relative mx-auto mt-20 max-w-5xl px-5 md:px-8">
    <div class="mx-auto mb-8 max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold text-white md:text-4xl">
        Built <span class="text-bb-success">better</span>, not just bigger.
      </h2>
      <p class="mt-3 text-bb-text-dim">How Block Kitz stacks up against the typical block-puzzle app.</p>
    </div>

    <div class="overflow-hidden rounded-[28px] ring-1 ring-white/10">
      <table class="w-full text-left text-sm">
        <thead class="bg-white/10 text-xs uppercase tracking-[0.15em] text-bb-text-faded">
          <tr>
            <th class="px-4 py-4 md:px-6">Feature</th>
            <th class="px-4 py-4 md:px-6 text-bb-primary">Block Kitz</th>
            <th class="px-4 py-4 md:px-6">Typical block puzzle</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {
            differentiators.map((d) => (
              <tr class="bg-white/[0.03]">
                <td class="px-4 py-4 font-semibold text-white md:px-6">{d.label}</td>
                <td class="px-4 py-4 text-bb-success md:px-6">✅ {d.bk}</td>
                <td class="px-4 py-4 text-bb-text-faded md:px-6">⚠️ {d.typical}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative mx-auto mt-20 max-w-3xl px-5 text-center md:px-8">
    <h2 class="text-3xl font-extrabold text-white md:text-4xl">
      Ready to <span class="text-bb-primary">jump in</span>?
    </h2>
    <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
      <a href="/download" class="bb-btn">
        <span aria-hidden="true">⬇️</span>
        <span>Get Block Kitz</span>
      </a>
      <a href="/screenshots" class="bb-btn bb-btn--ghost">See screenshots</a>
    </div>
  </section>
</BaseLayout>
