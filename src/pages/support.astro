---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockDecoration from '../components/BlockDecoration.astro';

const title = 'Support & FAQ — Block Kitz';
const description =
  'Frequently asked questions about Block Kitz — installation, progress, purchases, privacy, and ads. Get help directly from the developer.';

const faq = [
  {
    q: 'Is Block Kitz really free?',
    a: 'Yes — fully free to download and play. There are optional coin packs if you want to support development, but every level and every mode is playable without spending a penny.',
  },
  {
    q: 'Does Block Kitz collect any data?',
    a: 'No. We collect zero personal data. Your game progress, coins, and achievements are stored locally on your device and never sent to us. See our Privacy Policy for the full breakdown.',
  },
  {
    q: 'Are there forced ads?',
    a: 'No forced ads — no interstitials, no banner ads. Ads only play when you deliberately tap a "Watch Ad" button (for example, to revive after game-over, or to double a coin reward).',
  },
  {
    q: 'My child made a purchase without asking. Can I get a refund?',
    a: 'We add a parental math gate before every in-app purchase, but refunds are handled by Google Play. Open the Play Store app → Menu → Payments & subscriptions → Budget & history → tap the purchase → Refund. Contact support@blockkitz.com if Google declines and we\u2019ll help.',
  },
  {
    q: 'I lost my progress / I got a new phone.',
    a: 'Because Block Kitz stores everything locally with no account system, progress is tied to the device. We\u2019re looking into an optional cloud-backup feature for a future update — email support@blockkitz.com if this matters to you and we\u2019ll prioritize it.',
  },
  {
    q: 'How do I clear my game data?',
    a: 'Android Settings → Apps → Block Kitz → Storage → Clear Data. This wipes all local game data and starts you fresh.',
  },
  {
    q: 'Does it work without internet?',
    a: 'Yes — Block Kitz is fully playable offline. Internet is only needed if you choose to watch an optional rewarded ad.',
  },
  {
    q: 'What age is Block Kitz rated for?',
    a: 'Everyone / PEGI 3 / USK 0 / ESRB Everyone. It\u2019s designed to be safe and enjoyable for players of all ages, including children.',
  },
  {
    q: 'Is there an iOS version?',
    a: 'Not yet — Block Kitz launched on Android first. iOS is on the roadmap. Email support@blockkitz.com if you want to be notified when it ships.',
  },
  {
    q: 'I found a bug.',
    a: 'Please email support@blockkitz.com with a short description and, if you can, a screenshot. I read every email myself and prioritize bug reports.',
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="bb-stars relative overflow-hidden pt-10 pb-12 md:pt-16 md:pb-16">
    <BlockDecoration />
    <div class="relative z-10 mx-auto max-w-3xl px-5 text-center md:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-bb-primary">Support</p>
      <h1 class="mt-4 text-4xl font-extrabold text-white md:text-5xl">
        Got a <span class="text-bb-pink">question</span>?
      </h1>
      <p class="mt-4 text-lg text-bb-text-dim">
        Here are the most common ones. For anything else, email
        <a href="mailto:support@blockkitz.com" class="font-semibold text-bb-primary hover:underline">
          support@blockkitz.com
        </a>
        — I read every message personally.
      </p>
    </div>
  </section>

  <!-- Contact strip -->
  <section class="relative mx-auto max-w-4xl px-5 md:px-8">
    <div class="grid gap-5 md:grid-cols-2">
      <a
        href="mailto:support@blockkitz.com"
        class="group flex items-center gap-4 rounded-[28px] bg-white/5 p-6 ring-1 ring-white/10 transition hover:-translate-y-1 hover:bg-white/10 hover:ring-white/30"
      >
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-bb-primary to-bb-primary-dark text-2xl shadow-lg" aria-hidden="true">✉️</span>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-bb-text-faded">Email</p>
          <p class="font-display text-lg font-extrabold text-white">support@blockkitz.com</p>
        </div>
      </a>
      <a
        href="/safety"
        class="group flex items-center gap-4 rounded-[28px] bg-white/5 p-6 ring-1 ring-white/10 transition hover:-translate-y-1 hover:bg-white/10 hover:ring-white/30"
      >
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-bb-success to-bb-info text-2xl shadow-lg" aria-hidden="true">🛡️</span>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-bb-text-faded">Parents</p>
          <p class="font-display text-lg font-extrabold text-white">Children's Safety</p>
        </div>
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative mx-auto mt-16 max-w-3xl px-5 md:px-8">
    <h2 class="mb-6 text-center text-3xl font-extrabold text-white md:text-4xl">
      Frequently asked
    </h2>
    <div class="space-y-3">
      {
        faq.map((item) => (
          <details class="group rounded-2xl bg-white/5 ring-1 ring-white/10 transition hover:ring-white/20 open:bg-white/[0.08] open:ring-white/20">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-semibold text-white">
              <span>{item.q}</span>
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/10 text-lg transition group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="px-5 pb-5 text-bb-text-dim leading-relaxed">
              {item.a}
            </div>
          </details>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-bb-text-faded">
      Still stuck? Email
      <a href="mailto:support@blockkitz.com" class="font-semibold text-bb-primary hover:underline">
        support@blockkitz.com
      </a>
      — typical reply in a few business days.
    </p>
  </section>
</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
</style>
