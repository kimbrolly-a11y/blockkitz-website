---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';

import shot1 from '../assets/screenshots/1-levels.png';
import shot2 from '../assets/screenshots/2-no-ads.png';
import shot3 from '../assets/screenshots/3-modes.png';
import shot4 from '../assets/screenshots/4-family.png';
import shot5 from '../assets/screenshots/5-rewards.png';

const title = 'Block Kitz — The cozy block puzzle for everyone';
const description =
  'Block Kitz is a family-safe block-puzzle game for Android. 1,000+ levels, three game modes, zero data collected, zero forced ads. Free to play, fully offline.';

const features = [
  {
    icon: '🧩',
    title: 'Three distinct modes',
    description:
      'Classic drag-and-drop, Pivot (modern Tetris-style), and Adventure with gem objectives — all in one game.',
    accent: 'primary' as const,
  },
  {
    icon: '⭐',
    title: '1,000+ levels',
    description:
      'Ten themed chapters per mode, from "Hidden Glade" to "Soul\u2019s Nexus". Hand-crafted and beautiful.',
    accent: 'grape' as const,
  },
  {
    icon: '🛡️',
    title: 'Family-safe by design',
    description:
      'COPPA + GDPR-K aligned. No data collection. No forced ads. Parental gate on every purchase.',
    accent: 'success' as const,
  },
];

const heroShots = [
  { src: shot3, alt: 'Three game modes in Block Kitz' },
  { src: shot1, alt: 'Over one thousand levels' },
  { src: shot4, alt: 'Family-friendly design' },
  { src: shot5, alt: 'Daily rewards and spin wheel' },
  { src: shot2, alt: 'No forced ads' },
];
---

<BaseLayout title={title} description={description}>
  <Hero />

  <!-- Features -->
  <section class="relative mx-auto max-w-6xl px-5 pb-6 md:px-8">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold text-white md:text-4xl">
        Puzzle bliss, <span class="text-bb-primary">the right way</span>.
      </h2>
      <p class="mt-3 text-bb-text-dim">
        Built by one indie developer for kids, parents, and anyone who loves a cozy puzzle.
      </p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {features.map((f) => <FeatureCard {...f} />)}
    </div>
  </section>

  <!-- Screenshot row -->
  <section class="relative mx-auto max-w-6xl px-5 pt-16 md:px-8">
    <div class="mx-auto mb-8 max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold text-white md:text-4xl">
        A little <span class="text-bb-pink">peek</span> inside
      </h2>
      <p class="mt-3 text-bb-text-dim">
        Bright, bouncy, and built to delight.
      </p>
    </div>

    <div
      class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-6 md:grid md:grid-cols-5 md:gap-5 md:overflow-visible"
    >
      {
        heroShots.map((s) => (
          <div class="group relative shrink-0 snap-center md:shrink">
            <div class="overflow-hidden rounded-[28px] bg-white/5 p-2 ring-1 ring-white/10 transition group-hover:-translate-y-1 group-hover:ring-white/30">
              <Image
                src={s.src}
                alt={s.alt}
                widths={[220, 440]}
                sizes="(min-width: 768px) 18vw, 60vw"
                class="h-auto w-[60vw] rounded-[22px] md:w-full"
              />
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-2 text-center text-xs text-bb-text-faded md:hidden">
      Swipe to see more →
    </p>

    <div class="mt-8 text-center">
      <a href="/screenshots" class="text-sm font-semibold text-bb-primary hover:underline">
        See all screenshots →
      </a>
    </div>
  </section>

  <!-- Numbers strip -->
  <section class="relative mx-auto mt-20 max-w-6xl px-5 md:px-8">
    <div class="grid grid-cols-2 gap-4 rounded-[32px] bg-white/5 p-6 ring-1 ring-white/10 backdrop-blur-sm md:grid-cols-4 md:p-10">
      <div class="text-center">
        <p class="font-display text-4xl font-extrabold text-bb-primary md:text-5xl">1,000+</p>
        <p class="mt-2 text-xs font-semibold uppercase tracking-[0.2em] text-bb-text-faded">Levels</p>
      </div>
      <div class="text-center">
        <p class="font-display text-4xl font-extrabold text-bb-pink md:text-5xl">3</p>
        <p class="mt-2 text-xs font-semibold uppercase tracking-[0.2em] text-bb-text-faded">Game modes</p>
      </div>
      <div class="text-center">
        <p class="font-display text-4xl font-extrabold text-bb-success md:text-5xl">0</p>
        <p class="mt-2 text-xs font-semibold uppercase tracking-[0.2em] text-bb-text-faded">Data collected</p>
      </div>
      <div class="text-center">
        <p class="font-display text-4xl font-extrabold text-bb-info md:text-5xl">100%</p>
        <p class="mt-2 text-xs font-semibold uppercase tracking-[0.2em] text-bb-text-faded">Offline</p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="relative mx-auto mt-20 max-w-3xl px-5 text-center md:px-8">
    <h2 class="text-3xl font-extrabold text-white md:text-4xl">
      Ready to <span class="text-bb-primary">play</span>?
    </h2>
    <p class="mt-3 text-bb-text-dim">
      Free. Offline. No sign-up. No tracking. Just blocks.
    </p>
    <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
      <a href="/download" class="bb-btn">
        <span aria-hidden="true">⬇️</span>
        <span>Download Block Kitz</span>
      </a>
      <a href="/safety" class="bb-btn bb-btn--ghost">
        For parents
      </a>
    </div>
  </section>
</BaseLayout>
