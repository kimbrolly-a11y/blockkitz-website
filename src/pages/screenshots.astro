---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockDecoration from '../components/BlockDecoration.astro';

import shot1 from '../assets/screenshots/1-modes.png';
import shot2 from '../assets/screenshots/2-levels.png';
import shot3 from '../assets/screenshots/3-achievements.png';
import shot4 from '../assets/screenshots/4-adventure.png';
import shot5 from '../assets/screenshots/5-daily.png';

const title = 'Screenshots — Block Kitz';
const description =
  'See Block Kitz v1.0.1 in action — three game modes, 30 themed chapters, 22 achievements, and a daily system designed for family-safe play.';

const shots = [
  { src: shot1, alt: 'Block Kitz main menu — choose from Classic, Pivot Blocks, or Adventure', caption: 'Three game modes' },
  { src: shot2, alt: 'Classic Journey chapter progression — Rookie Grounds Chapter 1', caption: 'Chapter-based progression' },
  { src: shot3, alt: 'Achievement milestones screen in Block Kitz', caption: '22 hidden achievements' },
  { src: shot4, alt: 'Adventure mode gameplay — collect gems and dodge bombs', caption: 'Adventure: gems, bombs, frozen cells' },
  { src: shot5, alt: 'Daily system in Block Kitz — login streak, tasks, and challenges', caption: 'Daily login, tasks & challenges' },
];
---

<BaseLayout title={title} description={description}>
  <section class="bb-stars relative overflow-hidden pt-10 pb-8 md:pt-16 md:pb-10">
    <BlockDecoration />
    <div class="relative z-10 mx-auto max-w-3xl px-5 text-center md:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-bb-primary">Screenshots</p>
      <h1 class="mt-4 text-4xl font-extrabold text-white md:text-5xl">
        A little <span class="text-bb-pink">peek</span> inside.
      </h1>
      <p class="mt-4 text-lg text-bb-text-dim">
        Real gameplay from Block Kitz v1.0.1 — currently in Google Play Closed Testing.
      </p>
    </div>
  </section>

  <section class="relative mx-auto max-w-6xl px-5 pb-8 md:px-8">
    <div class="grid gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
      {
        shots.map((s) => (
          <figure class="group relative">
            <div class="overflow-hidden rounded-[28px] bg-white/5 p-2 ring-1 ring-white/10 transition group-hover:-translate-y-1 group-hover:ring-white/30">
              <Image
                src={s.src}
                alt={s.alt}
                widths={[220, 440, 720]}
                sizes="(min-width: 1024px) 18vw, (min-width: 768px) 30vw, (min-width: 640px) 45vw, 90vw"
                class="h-auto w-full rounded-[22px]"
              />
            </div>
            <figcaption class="mt-3 text-center text-sm font-semibold text-bb-text-dim">
              {s.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="relative mx-auto mt-16 max-w-3xl px-5 text-center md:px-8">
    <h2 class="text-3xl font-extrabold text-white md:text-4xl">
      Ready to <span class="text-bb-primary">play</span>?
    </h2>
    <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
      <a
        href="https://play.google.com/apps/testing/com.blockkitz.game"
        target="_blank"
        rel="noopener noreferrer"
        class="bb-btn"
      >
        <span aria-hidden="true">🎮</span>
        <span>Join the Beta</span>
      </a>
      <a href="/features" class="bb-btn bb-btn--ghost">Full feature list</a>
    </div>
  </section>
</BaseLayout>
