---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockDecoration from '../components/BlockDecoration.astro';
import appIcon from '../assets/app-icon-512.png';

const title = 'About — Block Kitz';
const description =
  'Block Kitz is developed by Hungry Humans on behalf of Infinity Tech. Learn why the game exists, how it was built, and the promises behind every design choice.';
---

<BaseLayout title={title} description={description}>
  <section class="bb-stars relative overflow-hidden pt-10 pb-12 md:pt-16 md:pb-16">
    <BlockDecoration />
    <div class="relative z-10 mx-auto max-w-3xl px-5 text-center md:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-bb-primary">About</p>
      <h1 class="mt-4 text-4xl font-extrabold text-white md:text-5xl">
        A small studio. <span class="text-bb-pink">Lots of love.</span>
      </h1>
      <p class="mt-4 text-lg text-bb-text-dim">
        Block Kitz is developed by <strong class="text-white">Hungry Humans</strong> on behalf of <strong class="text-white">Infinity Tech</strong> — a family-safe game built with care.
      </p>
    </div>
  </section>

  <section class="relative mx-auto max-w-3xl px-5 md:px-8">
    <div class="rounded-[32px] bg-white/5 p-6 ring-1 ring-white/10 md:backdrop-blur-sm md:p-10">
      <div class="flex items-center gap-5">
        <Image
          src={appIcon}
          alt="Block Kitz app icon"
          width={96}
          height={96}
          class="h-20 w-20 rounded-3xl shadow-xl ring-1 ring-white/10"
        />
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-bb-text-faded">Developed by</p>
          <p class="font-display text-2xl font-extrabold text-white">Hungry Humans</p>
          <p class="text-sm text-bb-text-dim">On behalf of Infinity Tech — design, code, audio, everything.</p>
        </div>
      </div>

      <div class="mt-8 space-y-5 text-bb-text-dim">
        <p>
          Block Kitz is developed by <strong class="text-white">Hungry Humans</strong> on behalf of <strong class="text-white">Infinity Tech</strong>. The studio set out to build a <strong class="text-white">cozy block-puzzle game</strong> that parents could hand to their kids without a second thought — one that wasn't drowning in forced ads, flashy monetization, or data-hungry tracking.
        </p>
        <p>
          Every pixel, every puzzle layout, and every sound effect was hand-picked or hand-tuned. The goal was never "make the most money" — it was "make something kids and parents can trust."
        </p>
        <p>
          That's why Block Kitz runs with <strong class="text-white">non-personalized ads only</strong>, <strong class="text-white">zero forced ads</strong>, and <strong class="text-white">no in-app purchases in the launch build</strong> — the only data touched is the advertising ID, used only to serve a non-personalized ad when the player taps "Watch Ad." It's why the spin wheel awards only free in-game coins, never randomized paid outcomes. It's why the music is four calm ambient piano moods, not a pumping arcade soundtrack.
        </p>
        <p>
          Block Kitz is designed to be <strong class="text-white">the block puzzle a family can trust</strong> — and if it ends up being yours too, that's the whole point.
        </p>
      </div>
    </div>
  </section>

  <!-- Promises -->
  <section class="relative mx-auto mt-16 max-w-4xl px-5 md:px-8">
    <div class="mx-auto mb-8 max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold text-white md:text-4xl">
        The <span class="text-bb-primary">promises</span>
      </h2>
      <p class="mt-3 text-bb-text-dim">Design rules I will never break.</p>
    </div>

    <ul class="grid gap-4 md:grid-cols-2">
      {
        [
          ['🛡️', 'Minimal data — advertising ID only.', 'Used only to serve a non-personalized ad when the player taps "Watch Ad." No profiles. No behavioural tracking. No data sharing.'],
          ['🎯', 'No forced ads.',              'Optional "Watch Ad" rewards only. The game is fully playable without a single ad.'],
          ['💬', 'No chat. No social.',         'No strangers can reach your child through Block Kitz.'],
          ['🎡', 'No gambling mechanics.',      'The spin wheel awards only free in-game coins. No mystery paid boxes.'],
          ['🧒', 'No purchases in v1.0.1.',     'The launch build is free with no in-app purchases. Optional cosmetic purchases with a parental math gate are planned for a later update.'],
          ['📴', 'Offline gameplay.',           'Gameplay works offline — only optional rewarded video ads need a connection. No login. No account. No sign-up.'],
        ].map(([icon, head, body]) => (
          <li class="flex gap-4 rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
            <span class="text-2xl" aria-hidden="true">{icon}</span>
            <div>
              <p class="font-bold text-white">{head}</p>
              <p class="mt-1 text-sm text-bb-text-dim">{body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Support the studio -->
  <section class="relative mx-auto mt-16 max-w-3xl px-5 md:px-8">
    <div class="rounded-[32px] bg-gradient-to-br from-bb-grape/25 via-bb-info/20 to-bb-pink/25 p-8 ring-1 ring-white/10 md:p-10">
      <div class="flex flex-col items-center gap-4 text-center">
        <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-bb-primary to-bb-primary-dark text-3xl shadow-lg" aria-hidden="true">💛</span>
        <h2 class="text-3xl font-extrabold text-white md:text-4xl">
          Help the studio make more games
        </h2>
        <p class="max-w-xl text-bb-text-dim">
          Block Kitz is <strong class="text-white">free to play</strong> — no forced ads, no subscriptions, and no in-app purchases in the launch build. If you or your kids love it, a one-time tip on the <a href="/support-the-dev" class="font-semibold text-bb-primary hover:underline">Support the studio</a> page helps <strong class="text-white">Hungry Humans</strong> keep building more cozy, kid-safe games.
        </p>
        <p class="max-w-xl text-sm text-bb-text-faded">
          Every tip goes directly to the studio and funds the next Hungry Humans title. Thank you. 💛
        </p>
        <div class="mt-2 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
          <a href="/download" class="bb-btn">
            <span aria-hidden="true">🎮</span>
            <span>Get Block Kitz free</span>
          </a>
          <a href="/support-the-dev" class="bb-btn bb-btn--ghost">
            <span aria-hidden="true">💛</span>
            <span>Send a tip</span>
          </a>
        </div>
        <p class="mt-3 text-xs text-bb-text-faded">
          Or email <a href="mailto:support@blockkitz.com" class="font-semibold text-bb-primary hover:underline">support@blockkitz.com</a> — the Hungry Humans team reads every message.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="relative mx-auto mt-16 max-w-3xl px-5 text-center md:px-8">
    <p class="text-bb-text-dim">
      Questions, bug reports, or just want to say hi?
    </p>
    <a
      href="mailto:support@blockkitz.com"
      class="mt-3 inline-block font-display text-xl font-extrabold text-bb-primary hover:underline"
    >
      support@blockkitz.com
    </a>
    <p class="mt-4 text-xs text-bb-text-faded">The Hungry Humans team reads every email.</p>
  </section>
</BaseLayout>
