---
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Game',
    links: [
      { href: '/features', label: 'Features' },
      { href: '/screenshots', label: 'Screenshots' },
      { href: '/download', label: 'Download' },
      {
        href: '/feedback',
        label: 'Beta tester? Send feedback →',
      },
    ],
  },
  {
    heading: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/support', label: 'Support & FAQ' },
      { href: '/support-the-dev', label: 'Send a tip 💛' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms of Service' },
      { href: '/cookies', label: 'Cookie Policy' },
      { href: '/safety', label: "Children's Safety" },
    ],
  },
];
---

<footer class="relative z-10 mt-24 border-t border-white/10 bg-bb-bg-deep/60 md:backdrop-blur-sm">
  <!-- FOOTER-FIX (2026-04-28): dedicated beta-tester feedback banner above
       the columns so the /feedback link is impossible to miss. -->
  <div class="border-b border-white/10 bg-gradient-to-r from-bb-pink/15 via-bb-primary/10 to-bb-pink/15">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-5 py-4 md:flex-row md:px-8">
      <p class="text-center text-sm font-semibold text-white md:text-left">
        🎮 <span class="text-bb-primary">Beta tester?</span> Your feedback shapes the launch.
      </p>
      <a
        href="/feedback"
        class="inline-flex items-center gap-2 rounded-full bg-bb-primary px-5 py-2 text-sm font-extrabold text-bb-bg-deep transition hover:scale-105 hover:bg-yellow-300"
      >
        Send feedback (2 min) →
      </a>
    </div>
  </div>
  <div class="mx-auto max-w-6xl px-5 py-12 md:px-8">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr_1fr]">
      <div>
        <p class="font-display text-2xl font-extrabold tracking-wide text-white">
          Block Kitz
        </p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-bb-text-faded">
          A cozy block-puzzle game for all ages. Kid-safe. Non-personalized ads only. No profiles built. No behavioral tracking. Developed by Hungry Humans on behalf of Infinity Tech.
        </p>
        <a
          href="mailto:support@blockkitz.com"
          class="mt-4 inline-block text-sm font-semibold text-bb-primary hover:underline"
        >
          support@blockkitz.com
        </a>
      </div>

      {
        columns.map((col) => (
          <div>
            <p class="font-display text-sm font-extrabold uppercase tracking-[0.2em] text-bb-text-faded">
              {col.heading}
            </p>
            <ul class="mt-4 space-y-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={(link as any).external ? '_blank' : undefined}
                    rel={(link as any).external ? 'noopener noreferrer' : undefined}
                    class="text-sm font-medium text-bb-text-dim transition hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-white/10 pt-6 text-xs text-bb-text-faded md:flex-row md:items-center">
      <p>© {year} Block Kitz. Developed by Hungry Humans on behalf of Infinity Tech.</p>
      <p>Kid-safe · Non-personalized ads only · No profiles built</p>
    </div>
  </div>
</footer>
