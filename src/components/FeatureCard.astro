---
export interface Props {
  icon: string;
  title: string;
  description: string;
  accent?: 'primary' | 'grape' | 'success' | 'info' | 'danger' | 'pink';
}

const { icon, title, description, accent = 'primary' } = Astro.props;

const accentMap: Record<string, string> = {
  primary: 'from-bb-primary to-bb-primary-dark',
  grape:   'from-bb-grape   to-bb-info',
  success: 'from-bb-success to-bb-info',
  info:    'from-bb-info    to-bb-grape',
  danger:  'from-bb-danger  to-bb-pink',
  pink:    'from-bb-pink    to-bb-danger',
};
---

<article class="group relative flex flex-col gap-4 rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 backdrop-blur-sm transition hover:-translate-y-1 hover:bg-white/10 hover:ring-white/20">
  <div class={`flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br ${accentMap[accent]} text-3xl shadow-lg`}>
    <span aria-hidden="true">{icon}</span>
  </div>
  <h3 class="text-xl font-extrabold text-white">{title}</h3>
  <p class="text-sm leading-relaxed text-bb-text-dim">{description}</p>
</article>
